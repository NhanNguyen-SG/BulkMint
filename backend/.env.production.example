# Application runtime
APP_ENV=production
ENABLE_API_DOCS=false
CORS_ALLOWED_ORIGINS=https://your-production-frontend.example

# OpenAI (server-only)
OPENAI_API_KEY=
OPENAI_LISTING_MODEL=gpt-4.1-mini

# Hosted Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Railway injects PORT automatically. Do not set it here.
